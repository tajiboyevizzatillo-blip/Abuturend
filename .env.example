# Django / backend
# MAJBURIY. docker compose bo'sh yoki o'zgaruvchan qiymatni qabul qilmaydi va
# ishga tushmaydi. Generatsiya:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Eslatma: "change-me-in-production" kabi o'rinbosar qiymatlar settings.py
# tomonidan rad etiladi (DEBUG=False da).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Ishga tushirishdan oldin real qiymat bilan almashtiring!
DJANGO_ALLOWED_HOSTS=abituriyent.orgtrace.uz,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://abituriyent.orgtrace.uz,http://localhost:3000,http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=https://abituriyent.orgtrace.uz,http://localhost:3000
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
# nginx oldida turgan proxy soni. DRF limitlari mijoz IP'sini shu qatlamlar
# orqali o'qiydi; 1 = nginx. 0 bo'lsa barcha so'rovlar proxy IP'sida
# hisoblanib, limit butun sayt uchun yagona chelaga aylanadi.
DJANGO_NUM_PROXIES=1

# Database (docker-compose ichida host=db; lokal rivojlantirishda localhost)
# Render/PaaS'da bu o'rniga bitta DATABASE_URL (postgres://...) ishlatiladi —
# settings.py dj-database-url orqali uni o'qiydi va sslmode=require ni
# o'zi qo'shadi. Ikkalasi birga bersa DATABASE_URL ustun turadi.
POSTGRES_DB=abiturend
POSTGRES_USER=abiturend
# MAJBURIY (docker compose bo'sh qiymatni qabul qilmaydi).
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend
# /api — same-origin; nginx /api/ ni backend'ga yo'naltiradi.
NEXT_PUBLIC_API_URL=/api

# Telegram bot (admin bildirishnomalar)
# Token: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Admin chat id: @userinfobot orqali topiladi
TELEGRAM_CHAT_ID=
# Qo'shimcha ruxsat etilgan chat id'lar (vergul bilan)
TELEGRAM_ALLOWED_CHAT_IDS=
# Webhook xavfsizlik kaliti (o'zingiz ixtiyoriy token tanlang)
TELEGRAM_WEBHOOK_SECRET=
# Webhook xost (masalan: abituriyent.orgtrace.uz)
TELEGRAM_WEBHOOK_HOST=
# /weak buyrug'i uchun bog'langan hisob (username yoki id). Bo'sh bo'lsa bot
# "bog'lanmagan" deb aytadi — xato bermaydi.
TELEGRAM_LINKED_USER=

# Zaif mavzular radari (weak-skill radar) — ixtiyoriy sozlamalar
# Mavzuni baholash uchun minimal javob soni (ostida "yetarli ma'lumot yo'q")
WEAK_SKILL_MIN_ANSWERS=5
# Zaif deb hisoblash chegarasi (%)
WEAK_SKILL_THRESHOLD=60
# "Eng zaif mavzular" ro'yxat uzunligi
WEAK_SKILL_TOPIC_LIMIT=5
# Bepul tarifda ko'rinadigan zaif mavzular soni
WEAK_SKILL_FREE_TOPICS=3
# Zaif mavzulardan olinadigan savollar soni
WEAK_SKILL_PRACTICE_COUNT=20

# Reyting (leaderboard) kesh muddati, soniya. Ommaviy va agregatli so'rov —
# qisqa TTL kesh uni og'irmaydi.
LEADERBOARD_CACHE_SECONDS=60

# To'lovlar — Payme (kassa → /webhooks/payme/) va Click (Shop API → /webhooks/click/)
# Kalitlar kabinetdan olinadi; bo'sh qoldirilsa webhook RAD etiladi (fail-closed).
# Payme: kassa sozlamalaridan login (ba'zi kabinetlarda "Paycom"), kalit,
#        merchant ID (checkout havolasidagi m=). Merchant API URL o'zgarmaydi.
PAYME_LOGIN=Paycom
PAYME_KEY=
PAYME_MERCHANT_ID=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Click: my.click.uz kabinetidan Service ID, Merchant ID va Secret Key.
# Sign formula: md5(click_trans_id+service_id+secret+merchant_trans_id[+merchant_prepare_id]+amount+action+sign_time)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_PAY_URL=https://my.click.uz/services/pay

# Email — parol tiklash xatlari uchun (lokalda console backend chiqaradi)
# Prod'da SMTP: DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=noreply@abituriyent.orgtrace.uz
# Parol tiklash havolasi shu manzildan boshlanadi (frontend)
FRONTEND_BASE_URL=https://abituriyent.orgtrace.uz

# MCP bridge (/mcp/) — MAJBURIY
# Bridge backend'dagi savol bankini (javoblar bilan) chiqaradi, shuning uchun
# autentifikatsiyasiz so'rovlarni RAD qiladi. Kalitni yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# So'rov header'i:  Authorization: Bearer <MCP_API_KEY>
# Bo'sh qoldirilMAYDI: docker compose bo'sh qiymatni qabul qilmaydi va ishga
# tushmaydi. Bridge darhol 503 bilan hamma so'rovni rad etadi (fail-closed).
# Quyidagini bajarib .env ga yozing (deploy skripti ham shuni qiladi):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=
# Qo'shimcha kalit: include_answers=true (to'g'ri javob/izoh) faqat shu kalit
# bilan ishlaydi. Bo'sh qoldirilsa javoblar hech qachon ochilmaydi.
MCP_ADMIN_API_KEY=